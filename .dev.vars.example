# Copy to .dev.vars. Values here override wrangler.jsonc vars locally.
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_GUILD_ID=your-guild-id
DISCORD_ROLE_ID=your-role-id
DISCORD_INVITE_URL=https://discord.gg/your-invite
SITE_URL=http://localhost:4321
# Use a long random string (for example the output of `openssl rand -hex 32`).
SESSION_SECRET=replace-with-a-long-random-string
