---
const title = "Student Hub";
const user = Astro.locals.user;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="glow" aria-hidden="true"></div>
		<main>
			<h1>{title}</h1>
			<p class="lead">Sign in with Discord to get your student role.</p>
			{
				user && (
					<p class="signed-in">Signed in as {user.username}</p>
				)
			}
			{
				user ? (
					<form class="action" method="post" action="/api/auth/logout">
						<button class="btn secondary" type="submit">Logout</button>
					</form>
				) : (
					<a class="action btn primary" href="/api/auth/login">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path
								fill="currentColor"
								d="M20.32 4.37a19.8 19.8 0 0 0-4.89-1.52.07.07 0 0 0-.08.04c-.21.37-.44.86-.61 1.25a18.27 18.27 0 0 0-5.49 0 12.64 12.64 0 0 0-.62-1.25.08.08 0 0 0-.08-.04A19.74 19.74 0 0 0 3.68 4.37a.07.07 0 0 0-.03.03C.53 9.05-.32 13.58.1 18.06a.08.08 0 0 0 .03.06 19.9 19.9 0 0 0 5.99 3.03.08.08 0 0 0 .09-.03c.46-.63.87-1.3 1.22-1.99a.08.08 0 0 0-.04-.11 13.1 13.1 0 0 1-1.87-.89.08.08 0 0 1-.01-.13c.12-.1.25-.2.37-.29a.07.07 0 0 1 .08-.01c3.93 1.79 8.18 1.79 12.06 0a.07.07 0 0 1 .08.01c.12.09.24.2.37.29a.08.08 0 0 1-.01.13 12.3 12.3 0 0 1-1.87.89.08.08 0 0 0-.04.11c.35.7.77 1.36 1.23 1.99a.08.08 0 0 0 .08.03 19.84 19.84 0 0 0 6-3.03.08.08 0 0 0 .04-.05c.5-5.18-.84-9.68-3.55-13.66a.06.06 0 0 0-.03-.03zM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.33-.96 2.42-2.16 2.42zm7.97 0c-1.18 0-2.16-1.08-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42z"
							/>
						</svg>
						Login with Discord
					</a>
				)
			}
		</main>
	</body>
</html>

<style>
	:root {
		--bg: #ffffff;
		--text: #0a0a0a;
		--muted: #737373;
		--border: #e5e5e5;
		--glow: #0a0a0a;
		--sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
		--mono: ui-monospace, "SFMono-Regular", Menlo, Monaco, Consolas, "Liberation Mono", monospace;
		--ease: cubic-bezier(0.22, 1, 0.36, 1);
		color-scheme: light;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0a0a0a;
			--text: #fafafa;
			--muted: #a3a3a3;
			--border: #262626;
			--glow: #fafafa;
			color-scheme: dark;
		}
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
	}

	body {
		min-height: 100dvh;
		display: grid;
		place-items: center;
		background: var(--bg);
		color: var(--text);
		font-family: var(--sans);
		-webkit-font-smoothing: antialiased;
	}

	.glow {
		position: fixed;
		top: 42%;
		left: 50%;
		z-index: 0;
		width: min(32rem, 90vw);
		height: min(32rem, 90vw);
		border-radius: 50%;
		background: radial-gradient(circle, var(--glow) 0%, transparent 68%);
		filter: blur(48px);
		opacity: 0.1;
		pointer-events: none;
		translate: -50% -50%;
		animation: drift 20s var(--ease) infinite;
	}

	main {
		position: relative;
		z-index: 1;
		box-sizing: border-box;
		width: min(480px, 100%);
		padding: 48px 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	h1,
	.lead,
	.signed-in,
	.action {
		animation: enter 500ms var(--ease) backwards;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 10vw, 3rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	.lead {
		margin: 16px 0 0;
		max-width: 100%;
		color: var(--muted);
		font-size: 0.9375rem;
		line-height: 1.5;
		text-wrap: balance;
		animation-delay: 60ms;
	}

	.signed-in {
		margin: 28px 0 0;
		color: var(--muted);
		font-family: var(--mono);
		font-size: 0.8125rem;
		line-height: 1.4;
		animation-delay: 120ms;
	}

	.action {
		margin-top: 28px;
		animation-delay: 120ms;
	}

	.signed-in + .action {
		margin-top: 12px;
		animation-delay: 180ms;
	}

	.btn {
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		height: 44px;
		padding: 0 20px;
		border: 1px solid transparent;
		border-radius: 9999px;
		font-family: var(--sans);
		font-size: 0.9375rem;
		font-weight: 500;
		line-height: 1;
		text-decoration: none;
		cursor: pointer;
		transition:
			transform 180ms var(--ease),
			background-color 180ms var(--ease);
	}

	.btn svg {
		width: 18px;
		height: 18px;
		flex: none;
	}

	.primary {
		background: var(--text);
		color: var(--bg);
	}

	.primary:hover {
		background: color-mix(in srgb, var(--text) 86%, var(--bg));
		transform: translateY(-1px);
	}

	.secondary {
		background: transparent;
		color: var(--text);
		border-color: var(--border);
	}

	.secondary:hover {
		background: color-mix(in srgb, var(--text) 6%, var(--bg));
		transform: translateY(-1px);
	}

	.btn:active {
		transform: scale(0.98);
	}

	.btn:focus {
		outline: none;
	}

	.btn:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 2px;
	}

	@keyframes enter {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes drift {
		0%,
		100% {
			transform: translate3d(-28px, -18px, 0);
		}
		50% {
			transform: translate3d(36px, 22px, 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation: none !important;
			transition: none !important;
		}
	}
</style>
