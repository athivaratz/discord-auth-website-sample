---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import DiscordIcon from "../components/DiscordIcon.astro";
import GitHubIcon from "../components/GitHubIcon.astro";

const BRAND = "Student";
const BRAND_SUFFIX = ".hub";
const REPO_URL = "https://github.com/athivaratz/discord-auth-boilerplate";
const INVITE_URL =
	import.meta.env.PUBLIC_DISCORD_INVITE_URL || "https://discord.gg/your-invite";

type State = "signedOut" | "noMember" | "granted" | "error";

const user = Astro.locals.user;

let state: State = "signedOut";
if (user && Astro.locals.demoState) {
	state = Astro.locals.demoState;
}

const name = user?.username ?? "";

const listCount = state === "signedOut" ? 3 : state === "noMember" ? 2 : 0;
const showNote = state !== "signedOut";
const showQuietLogout = state === "noMember";

let step = 1;
const noteDelay = step * 60;
if (showNote) step += 1;
const firstListDelay = step * 60;
step += listCount;
const actionsDelay = step * 60;
step += 1;
const quietDelay = step * 60;
if (showQuietLogout) step += 1;
const footerDelay = step * 60;

const listDelay = (index: number) => firstListDelay + index * 60;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Student Hub</title>
	</head>
	<body>
		<main>
			<h1 class="rise">
				<span class="brand">{BRAND}</span><span class="suffix">{BRAND_SUFFIX}</span>
			</h1>
			{
				state === "noMember" && (
					<p class="note rise" style={`animation-delay: ${noteDelay}ms`}>
						Signed in as {name}.
					</p>
				)
			}
			{
				state === "granted" && (
					<p class="note rise" style={`animation-delay: ${noteDelay}ms`}>
						Signed in as {name}. Your <code>{BRAND}</code> role is ready.
					</p>
				)
			}
			{
				state === "error" && (
					<p class="note rise" style={`animation-delay: ${noteDelay}ms`}>
						Signed in as {name}. We could not check your role right now. Try again in a minute.
					</p>
				)
			}
			{
				state === "signedOut" && (
					<ol>
						<li class="rise" style={`animation-delay: ${listDelay(0)}ms`}>
							Press <code>Login with Discord</code> and approve the request.
						</li>
						<li class="rise" style={`animation-delay: ${listDelay(1)}ms`}>
							Join the server if you are not in it yet, then press <code>Check again</code>.
						</li>
						<li class="rise" style={`animation-delay: ${listDelay(2)}ms`}>
							Your <code>{BRAND}</code> role is added to you automatically.
						</li>
					</ol>
				)
			}
			{
				state === "noMember" && (
					<ol>
						<li class="rise" style={`animation-delay: ${listDelay(0)}ms`}>
							Join the server with the button below.
						</li>
						<li class="rise" style={`animation-delay: ${listDelay(1)}ms`}>
							Come back and press <code>Check again</code>.
						</li>
					</ol>
				)
			}
			{
				state === "signedOut" && (
					<div class="actions rise" style={`animation-delay: ${actionsDelay}ms`}>
						<a class="btn primary" href="/api/auth/login">
							<DiscordIcon />
							Login with Discord
						</a>
						<a
							class="btn secondary"
							href={INVITE_URL}
							target="_blank"
							rel="noopener noreferrer"
						>
							Join the server
						</a>
					</div>
				)
			}
			{
				state === "noMember" && (
					<div class="actions rise" style={`animation-delay: ${actionsDelay}ms`}>
						<form method="post" action="/api/recheck">
							<button class="btn primary" type="submit">Check again</button>
						</form>
						<a
							class="btn secondary"
							href={INVITE_URL}
							target="_blank"
							rel="noopener noreferrer"
						>
							<DiscordIcon />
							Join the server
						</a>
					</div>
				)
			}
			{
				state === "granted" && (
					<div class="actions rise" style={`animation-delay: ${actionsDelay}ms`}>
						<form method="post" action="/api/auth/logout">
							<button class="btn secondary" type="submit">Logout</button>
						</form>
						<a
							class="btn secondary"
							href={INVITE_URL}
							target="_blank"
							rel="noopener noreferrer"
						>
							Open the server
						</a>
					</div>
				)
			}
			{
				state === "error" && (
					<div class="actions rise" style={`animation-delay: ${actionsDelay}ms`}>
						<form method="post" action="/api/recheck">
							<button class="btn primary" type="submit">Check again</button>
						</form>
						<form method="post" action="/api/auth/logout">
							<button class="btn secondary" type="submit">Logout</button>
						</form>
					</div>
				)
			}
			{
				showQuietLogout && (
					<form class="rise" style={`animation-delay: ${quietDelay}ms`} method="post" action="/api/auth/logout">
						<button class="quiet" type="submit">Logout</button>
					</form>
				)
			}
		</main>
		<footer class="rise" style={`animation-delay: ${footerDelay}ms`}>
			<a href={REPO_URL} target="_blank" rel="noopener noreferrer">
				<GitHubIcon />
				Go to repository
				<span aria-hidden="true">→</span>
			</a>
		</footer>
	</body>
</html>

<style>
	:root {
		--bg: #ffffff;
		--text: #171717;
		--muted: #666666;
		--code-bg: rgba(0, 0, 0, 0.05);
		--line: rgba(0, 0, 0, 0.08);
		--primary-hover: #383838;
		--secondary-hover: #f2f2f2;
		--sans: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
		--mono: "Geist Mono Variable", ui-monospace, SFMono-Regular, Menlo, monospace;
		--ease: cubic-bezier(0.22, 1, 0.36, 1);
		color-scheme: light;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0a0a0a;
			--text: #ededed;
			--muted: #a1a1a1;
			--code-bg: rgba(255, 255, 255, 0.06);
			--line: rgba(255, 255, 255, 0.145);
			--primary-hover: #cccccc;
			--secondary-hover: #1a1a1a;
			color-scheme: dark;
		}
	}

	html {
		background: var(--bg);
	}

	body {
		box-sizing: border-box;
		margin: 0;
		min-height: 100dvh;
		display: grid;
		grid-template-rows: 20px 1fr 20px;
		align-items: center;
		justify-items: center;
		row-gap: 64px;
		padding: 32px 32px 80px;
		background: var(--bg);
		color: var(--text);
		font-family: var(--sans);
		-webkit-font-smoothing: antialiased;
	}

	main {
		grid-row: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 32px;
		width: min(480px, 100%);
		text-align: center;
	}

	h1 {
		display: flex;
		align-items: baseline;
		margin: 0;
		font-family: var(--sans);
		font-weight: 700;
		line-height: 1;
		color: var(--text);
	}

	.brand {
		font-size: 40px;
		letter-spacing: -0.04em;
		text-transform: uppercase;
	}

	.suffix {
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	.note,
	ol {
		margin: 0;
		font-family: var(--mono);
		font-size: 14px;
		line-height: 24px;
		letter-spacing: -0.01em;
	}

	ol {
		padding: 0;
		list-style: decimal inside;
	}

	li {
		margin-bottom: 8px;
	}

	code {
		font-family: var(--mono);
		font-weight: 600;
		padding: 2px 4px;
		border-radius: 4px;
		background: var(--code-bg);
	}

	.actions {
		display: flex;
		flex-direction: column;
		gap: 16px;
		width: 100%;
	}

	.actions form {
		display: contents;
	}

	.btn {
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		height: 40px;
		margin: 0;
		padding: 0 16px;
		border: 1px solid transparent;
		border-radius: 9999px;
		font-family: var(--sans);
		font-size: 14px;
		font-weight: 500;
		line-height: 1;
		white-space: nowrap;
		text-decoration: none;
		cursor: pointer;
		transition:
			background-color 180ms,
			border-color 180ms,
			transform 180ms;
	}

	.btn svg {
		width: 20px;
		height: 20px;
		flex: none;
	}

	.primary {
		background: var(--text);
		color: var(--bg);
	}

	.primary:hover {
		background: var(--primary-hover);
	}

	.secondary {
		background: transparent;
		color: var(--text);
		border-color: var(--line);
	}

	.secondary:hover {
		background: var(--secondary-hover);
		border-color: transparent;
	}

	.btn:hover {
		transform: translateY(-1px);
	}

	.btn:active {
		transform: scale(0.98);
	}

	.quiet {
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--muted);
		font-family: var(--sans);
		font-size: 14px;
		line-height: 20px;
		cursor: pointer;
	}

	.quiet:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	footer {
		grid-row: 3;
		display: flex;
		justify-content: center;
		gap: 24px;
	}

	footer a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: inherit;
		font-family: var(--sans);
		font-size: 14px;
		line-height: 20px;
		text-decoration: none;
	}

	footer a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	footer svg {
		width: 16px;
		height: 16px;
		flex: none;
	}

	.btn:focus,
	footer a:focus,
	.quiet:focus {
		outline: none;
	}

	.btn:focus-visible,
	footer a:focus-visible,
	.quiet:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 2px;
	}

	.rise {
		animation: rise 500ms var(--ease) backwards;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (min-width: 640px) {
		body {
			padding: 80px;
		}

		main {
			align-items: flex-start;
			text-align: left;
		}

		.actions {
			flex-direction: row;
			width: auto;
		}

		.btn {
			width: auto;
			height: 48px;
			padding: 0 20px;
			font-size: 16px;
		}
	}

	@media (min-width: 768px) {
		.secondary {
			min-width: 158px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation: none !important;
			transition: none !important;
		}
	}
</style>
