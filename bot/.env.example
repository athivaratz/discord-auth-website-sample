# Bot token from the Developer Portal, Bot page.
DISCORD_BOT_TOKEN=your-bot-token
# Application ID from General Information.
DISCORD_CLIENT_ID=your-client-id
# Server ID. Turn on Developer Mode, then right click the server.
DISCORD_GUILD_ID=your-guild-id
# Student role ID. Right click the role with Developer Mode on.
DISCORD_ROLE_ID=your-role-id
# Public site URL. Use https://, or http://localhost for local development.
SITE_URL=https://student-hub.example
